# ---------------------------------------------------------------------------
# Environment example for Worksuite (copy to .env and edit values as needed)
# This file lists environment variables used by the application and short
# explanations so you (or other developers) understand their purpose.
#
# Important: All original variable names and values are preserved below.
# Only add values in your real `.env` file. Never commit secrets to version
# control. Lines starting with `#` are comments and ignored by the app.
# ---------------------------------------------------------------------------

# Human-friendly application name. Shown in the UI and in automated emails.
APP_NAME=WORKSUITE-SAAS

# Application encryption key (Laravel). Keep this secret. If you change it,
# existing encrypted data (passwords, API tokens encrypted by the app) may
# become invalid. Generated using `php artisan key:generate`.
APP_KEY=base64:wID/CO/WkfE3yoWpQOoy15de8FtOpvC3dM/z5FuHiEU=

# ---------------------------------------------------------------------------
# Runtime environment settings
# ---------------------------------------------------------------------------
# Do not change APP_ENV to anything else. It will affect emailing from admin panel
# and other configuration from databse and system may crash
# Typical values: local, production, staging, codecanyon (used by this project)
APP_ENV=codecanyon

# Enable/disable debug mode. true shows detailed stack traces and debug info;
# false hides details and should be used in production.
APP_DEBUG=false

# The base URL of your application. Used when building absolute URLs in
# emails and redirects. Example: https://example.com or http://localhost
APP_URL=http://localhost

# Redirect all traffic to HTTPS if set to true. Useful when your app is served
# behind a proxy or uses an HTTPS-only domain.
# For many deployments this can stay false and be handled by the webserver.
REDIRECT_HTTPS=false

# When true, the system will use a verified 'from' email address for outgoing
# mail. If your mail provider requires a verified sender, set this to true.
MAIL_FROM_VERIFIED_EMAIL=true

# If your main application is installed on a subdomain, set it here. Leave
# empty if the application is on the root domain. Example: "app" for
# app.example.com
MAIN_APPLICATION_SUBDOMAIN=

# ---------------------------------------------------------------------------
# Database connection
# ---------------------------------------------------------------------------
# Database driver (mysql, pgsql, sqlite, sqlsrv)
DB_CONNECTION=mysql

# The database server host (IP or hostname)
DB_HOST=127.0.0.1

# The database server port
DB_PORT=3306

# The database name used by the application
DB_DATABASE=laravel

# The database username and password
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Frontend build / broadcast (Mix) settings
# ---------------------------------------------------------------------------
# These are injected into webpack/mix builds and used by frontend code.
# They reference the underlying Pusher variables so the frontend can connect
# to the realtime/broadcasting service. Keep them as-is unless you use a
# different broadcast provider.
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
