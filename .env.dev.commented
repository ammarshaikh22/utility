# Commented copy of .env.dev
# Each variable below has a short explanation showing how and where it's commonly used.
# Do NOT commit secrets to public repos. Keep production keys private.

# Application display name (used in email "from" name, UI headings, etc.)
APP_NAME=Worksuite

# APP_ENV controls environment-specific behavior. The project warns to keep this `codecanyon` for their packaged distribution.
# Common values: local, production, staging, codecanyon (this project-specific)
# Used across configs to decide behavior (see config/log-viewer.php, config/app.php)
APP_ENV=codecanyon

# Whether to show debug info. In production this should be false.
APP_DEBUG=false

# Application encryption key (Laravel APP_KEY). Generated by `php artisan key:generate`.
# Used by Laravel to encrypt sessions, cookies, and other encrypted data.
APP_KEY=base64:wID/CO/WkfE3yoWpQOoy15de8FtOpvC3dM/z5FuHiEU=

# Toggles API debug responses (project specific)
APP_API_DEBUG=true

# Base URL used to build absolute links in emails or redirects
APP_URL=http://localhost

# If true, forces redirect to https (project-specific variable)
REDIRECT_HTTPS=false

# Logging level (debug, info, warning, error, critical)
LOG_LEVEL=debug
LOG_CHANNEL=daily

# Default app language/locale
APP_LOCALE="en"

# Database connection settings. Laravel uses these in config/database.php
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Enable/disable Laravel Debugbar (dev tool) — used by config/debugbar.php
DEBUGBAR_ENABLED=false

# Cache/queue/session drivers
BROADCAST_DRIVER=null
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail configuration. NOTE: When APP_ENV is 'codecanyon' this project may override mail behavior.
# MAIL_MAILER can be smtp, sendmail, log, etc. log is useful locally.
MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# AWS (S3) credentials and bucket name — used by filesystems/config and queue/cache when S3 is configured.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Pusher (realtime notifications) credentials — used in broadcasting/pusher config and front-end mix vars
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# These are used by Laravel Mix for the front-end (window.__PUSHER__) when building assets
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# JWT secret (for JSON Web Tokens, if project uses jwt-auth or similar)
JWT_SECRET=z6dl6gOuGtZj26ipPx5mgbHABkmCKNrqBwZON555Rx96UR7jDl7iuO5ONZoldMj5

# Apple Push Notification PEM filename path used by the push notification config
APN_PEM=aps.pem

# Firebase Cloud Messaging key — used to send push notifications to Android/iOS clients
FCM_KEY=

# PAYMENTS: keys and endpoints for various payment gateways used by the app (only enable the ones you need)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co
MERCHANT_EMAIL=

MOLLIE_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

PF_MERCHANT_ID=
PF_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

AUTHORIZE_PAYMENT_API_LOGIN_ID=
AUTHORIZE_PAYMENT_TRANSACTION_KEY=
AUTHORIZE_SANDBOX=true

# SQUARE payments
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT='sandbox' # Use sandbox or production

# Google OAuth/Calendar credentials — used if the app integrates with Google APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Flutterwave (FLW) public/secret keys
FLW_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_HASH=FLWSECK_xxxxxxxxxxxxx

# Optional EHLO domain for mail servers
MAIL_EHLO_DOMAIN=

# NOTES on usage and security:
# - Many of the env variables are referenced from config/*.php files in this Laravel project (for example, DB_* in config/database.php, MAIL_* in config/mail.php, AWS_* in config/filesystems.php).
# - Laravel's config files typically call env('SOME_KEY', 'default') and then your app uses config('some.section') rather than calling env() directly. This allows configuration caching (php artisan config:cache).
# - Never hard-code secrets in code or commit production keys. Use environment variables or a secrets manager.
# - To change values locally, edit .env.dev (or .env) and restart queue/workers if necessary.

# End of annotated file
